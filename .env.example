# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_admin_user_id_here

# Database Configuration (SQLite by default, change for PostgreSQL)
# SQLite (default): sqlite+aiosqlite:///users.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/telegram_bot
DATABASE_URL=sqlite+aiosqlite:///users.db

# Redis Configuration (optional, for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Bot Configuration
NOTIFICATION_INTERVAL=500  # Notify admin every N users
RATE_LIMIT_REQUESTS=100    # Max requests per user
RATE_LIMIT_SECONDS=60      # Rate limit window in seconds

# PostgreSQL Configuration (if using Docker Compose)
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpassword
