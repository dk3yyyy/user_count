# Required Telegram configuration
BOT_TOKEN=replace_with_botfather_token
ADMIN_ID=replace_with_numeric_telegram_user_id

# Direct Python execution uses SQLite unless this is changed.
DATABASE_URL=sqlite+aiosqlite:///users.db

# Redis is optional for direct execution. Uncomment when available.
# REDIS_URL=redis://:replace_with_redis_password@localhost:6379/0

# Positive integer bot settings
NOTIFICATION_INTERVAL=500
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SECONDS=60

# Required by Docker Compose
POSTGRES_USER=botuser
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_PASSWORD_URLENCODED=replace_with_url_encoded_postgres_password
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_PASSWORD_URLENCODED=replace_with_url_encoded_redis_password
